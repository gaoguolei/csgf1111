<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.pcms.project.mapper.PvProjectRemarkMapper">

        <delete id="physicalDeleteByMainId" parameterType="java.lang.Integer">
            DELETE
            FROM pv_project_remark
            WHERE
            project_id = #{mainId}
        </delete>
    <update id="deleteByMainId" parameterType="java.lang.Integer">
        update pv_project_remark
        set del_flag = 1
        where project_id = #{mainId}
    </update>

    <update id="updateByIdNew">
        update pv_project_remark set remark = #{p.remark} where id = #{p.id}
    </update>

    <select id="selectByMainId" parameterType="java.lang.Integer"
            resultType="org.jeecg.modules.pcms.project.entity.PvProjectRemark">
        SELECT *
        FROM pv_project_remark
<!--        WHERE del_flag = 0-->
        WHERE
        project_id = #{mainId}
    </select>

    <select id="selectByProjectInfoId" resultType="org.jeecg.modules.pcms.project.entity.PvProjectRemark">
        SELECT *
        FROM pv_project_remark
        <!--        WHERE del_flag = 0-->
        WHERE
        project_id = #{mainId}
    </select>

</mapper>
