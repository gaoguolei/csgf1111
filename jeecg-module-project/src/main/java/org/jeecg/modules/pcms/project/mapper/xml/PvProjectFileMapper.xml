<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.pcms.project.mapper.PvProjectFileMapper">

    <delete id="physicalDeleteByMainId" parameterType="java.lang.Integer">
        DELETE
        FROM pv_project_file
        WHERE
        project_id = #{mainId}
    </delete>
    <update id="deleteByMainId" parameterType="java.lang.Integer">
        update pv_project_file
        set del_flag = 1
        where project_id = #{mainId}
    </update>
    <select id="selectByMainId" parameterType="java.lang.Integer"
            resultType="org.jeecg.modules.pcms.project.entity.PvProjectFile">
        SELECT *
        FROM pv_project_file
<!--        WHERE del_flag = 0-->
        WHERE project_id = #{mainId}
    </select>

    <select id="getExpirationList" parameterType="java.lang.Integer" resultType="org.jeecg.modules.pcms.project.entity.PvProjectFile">
        select * from pv_project_file
        where del_flag = 0
            and project_id = #{mainId}
            and is_original_deleted = 'N'
    </select>
</mapper>
